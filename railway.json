{
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true",
    "healthcheckPath": "/_stcore/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
